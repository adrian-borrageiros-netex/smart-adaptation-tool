# .env de la app EN EL SERVIDOR (~/sarela-adaptacion/.env). No se versiona ni entra en la imagen.
# Ningún valor se pega en una conversación, un ticket ni un correo.
#
# La conexión a Keycloak y a la base de datos no va aquí: la escribe
# ~/plataforma/scripts/nueva_app.sh en .env.plataforma, junto con DEMOS_HOST aquí.

# Clave de la API de Anthropic, de un espacio de trabajo propio con tope de gasto.
ANTHROPIC_API_KEY=

# Opcionales.
# SARELA_IA_MODELO=claude-opus-5-5
# SARELA_IA_CONCURRENCIA=2
# SARELA_IA_FALLBACKS=default

# Solo para desarrollo en local, sin Keycloak (python -m uvicorn web.app:aplicacion):
# SARELA_LOCAL=1
# PYTHONPATH=../demos-plataforma/kit